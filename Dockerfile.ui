# syntax=docker/dockerfile:1
# MineralVision web UI (React + Vite -> nginx)

FROM node:20-alpine AS build

WORKDIR /build
COPY MineralVision_Final_Package/src/ui/web/mineralvision-app/package.json \
     MineralVision_Final_Package/src/ui/web/mineralvision-app/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY MineralVision_Final_Package/src/ui/web/mineralvision-app/ ./
RUN npm run build

FROM nginx:alpine AS runtime

COPY infrastructure/nginx/ui.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
