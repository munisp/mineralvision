# Render this template only in a protected runtime directory. Never commit the
# resulting config because it contains a repository cipher secret.
# PostgreSQL data directory for the official PostGIS image is /var/lib/postgresql/data.

[mineralvision]
pg1-path=/var/lib/postgresql/data

[global]
repo1-type=s3
repo1-s3-endpoint=${PGBACKREST_REPO1_S3_ENDPOINT}
repo1-s3-bucket=${PGBACKREST_REPO1_S3_BUCKET}
repo1-s3-key=${PGBACKREST_REPO1_S3_KEY}
repo1-s3-key-secret=${PGBACKREST_REPO1_S3_KEY_SECRET}
repo1-s3-region=${PGBACKREST_REPO1_S3_REGION}
repo1-s3-uri-style=path
repo1-s3-verify-tls=y
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=${PGBACKREST_CIPHER_PASS}
repo1-retention-full=2
repo1-retention-diff=7
repo1-retention-archive-type=full
compress-type=zst
compress-level=3
log-level-console=info
log-level-file=info
log-path=/var/log/pgbackrest
start-fast=y

[global:archive-push]
process-max=2

[global:backup]
process-max=2
