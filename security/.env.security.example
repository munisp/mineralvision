# Copy to a secret-managed deployment environment. Never commit real values.
ENV=production
PUBLIC_FQDN=app.example.com
IDP_FQDN=auth.example.com
ACME_EMAIL=security-operations@example.com

# Generate unique high-entropy values through the organization secret manager.
POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_SECRET
POSTGRES_APP_PASSWORD=REPLACE_WITH_SECRET
POSTGRES_MIGRATOR_PASSWORD=REPLACE_WITH_SECRET
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_SECRET
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_NAMED_ADMIN
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_SECRET
REDIS_PASSWORD=REPLACE_WITH_SECRET

# OIDC: imported Keycloak realm and API client must match these values.
AUTH_MODE=oidc
OIDC_ISSUER=https://auth.example.com/realms/mineralvision
OIDC_AUDIENCE=mineralvision-api
OIDC_JWKS_URL=https://auth.example.com/realms/mineralvision/protocol/openid-connect/certs
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OPA_ENABLED=true
OPA_URL=http://opa:8181
OPA_FAIL_CLOSED=true

# Container images must be pinned to a vetted immutable digest during change control.
CADDY_IMAGE=caddy:2.8.4-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0.7
OPA_IMAGE=openpolicyagent/opa:0.70.0-static
APPSEC_APISIX_IMAGE=ghcr.io/openappsec/apisix-attachment:REPLACE_WITH_VETTED_TAG_OR_DIGEST
APPSEC_AGENT_IMAGE=ghcr.io/openappsec/agent:REPLACE_WITH_VETTED_TAG_OR_DIGEST
POSTGRES_IMAGE=postgis/postgis:16-3.4
REDIS_IMAGE=redis:7.4.1-alpine

# OpenAppSec management is optional. Empty token selects local declarative management.
APPSEC_AGENT_TOKEN=
APPSEC_USER_EMAIL=

# These values are deliberately conservative starting points. Tune with load tests.
PUBLIC_MAX_REQUEST_BODY=25MB
API_MAX_REQUEST_BODY=25MB

# External SIEM forwarding. The collector must be reachable only over a private
# network/VPN and present a certificate chaining to SIEM_CA_CERT_PATH.
FLUENT_BIT_IMAGE=cr.fluentbit.io/fluent/fluent-bit:3.2.2
SIEM_FORWARD_HOST=siem-collector.internal.example
SIEM_FORWARD_PORT=24224
SIEM_FORWARD_SHARED_KEY=REPLACE_WITH_SECRET
SIEM_CA_CERT_PATH=/secure/certificates/siem-ca.pem

# PostgreSQL backup/PITR. Store the repository in an encrypted, versioned object
# store or independent backup host. Keep the cipher passphrase in a separate
# secret-manager path from the repository credentials.
PGBACKREST_REPO1_S3_ENDPOINT=s3.example.com
PGBACKREST_REPO1_S3_BUCKET=mineralvision-postgres-backups
PGBACKREST_REPO1_S3_KEY=REPLACE_WITH_SECRET
PGBACKREST_REPO1_S3_KEY_SECRET=REPLACE_WITH_SECRET
PGBACKREST_CIPHER_PASS=REPLACE_WITH_SECRET
