# MineralVision Platform - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/mineralvision
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# SQLite (for development)
SQLITE_DATABASE_URL=sqlite:///./mineralvision.db

# =============================================================================
# AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# REDIS CACHE
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# KAFKA STREAMING
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=mineralvision-group
KAFKA_AUTO_OFFSET_RESET=earliest

# =============================================================================
# OBJECT STORAGE (RustFS/S3-compatible)
# =============================================================================
# Backend type: rustfs, minio, aws_s3, local
OBJECT_STORE_BACKEND=rustfs

# RustFS/S3 endpoint configuration
S3_ENDPOINT=http://localhost:9000
RUSTFS_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your-access-key-here
S3_SECRET_KEY=your-secret-key-here
RUSTFS_ACCESS_KEY=your-access-key-here
RUSTFS_SECRET_KEY=your-secret-key-here
S3_BUCKET_NAME=mineralvision
S3_REGION=us-east-1
S3_PATH_STYLE=true
S3_SECURE=false

# Legacy MinIO support (deprecated, use RustFS)
# S3_ENDPOINT_URL=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# =============================================================================
# MLFLOW TRACKING
# =============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=mineralvision-experiments

# =============================================================================
# WALDO DETECTION
# =============================================================================
WALDO_MODEL_PATH=models/waldo/yolov8n.pt
WALDO_CONFIDENCE_THRESHOLD=0.5
WALDO_IOU_THRESHOLD=0.45
WALDO_DEVICE=cuda

# =============================================================================
# EXTERNAL APIS
# =============================================================================
# Climate Data
OPENWEATHER_API_KEY=your-openweather-api-key
NASA_EARTHDATA_TOKEN=your-nasa-token

# Geospatial Services
MAPBOX_ACCESS_TOKEN=your-mapbox-token
GOOGLE_MAPS_API_KEY=your-google-maps-key

# =============================================================================
# OBSERVABILITY
# =============================================================================
# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mineralvision

# Prometheus
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# =============================================================================
# SECURITY
# =============================================================================
# HashiCorp Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token

# Wazuh SIEM
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh

# =============================================================================
# MIDDLEWARE SERVICES
# =============================================================================
# Temporal Workflow
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=mineralvision

# Dapr
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001

# APISIX Gateway
APISIX_ADMIN_URL=http://localhost:9180
APISIX_ADMIN_KEY=your-apisix-admin-key

# OpenSearch
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin

# =============================================================================
# CORS SETTINGS
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
